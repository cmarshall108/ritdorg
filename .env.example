# Copy this to .env and fill in real values. NEVER commit .env.

# Flask session signing key (any long random string).
SECRET_KEY=change-me-to-a-long-random-string

# --- Admin panel ---
# Username for /admin/login. Default: admin
ADMIN_USER=admin
# Generate with: python ritdorg/set_admin_password.py  (or python -m ritdorg.set_admin_password)
ADMIN_PASS_HASH='scrypt:32768:8:1$BJFIkAPqeJVq0wbD$4cc538da8e331981e0d0427a1067e58970bd90aaefdfd8dca24a42b0088ff5a0e8c11c6e5f0d90a33729a8de1dc9afd2c003d35cafee9923215f580be91ae35f'

