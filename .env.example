# Copy this to .env and fill in real values. NEVER commit .env.

# Flask session signing key. Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=

# --- Admin panel ---
# Username for /admin/login. Defaults to admin; login is disabled until a hash is set.
ADMIN_USER=admin
# Generate with: python ritdorg/set_admin_password.py  (or python -m ritdorg.set_admin_password)
ADMIN_PASS_HASH=

# --- Optional ---
# Path to the SQLite auth DB. Defaults to ./data/auth.db
# AUTH_DB_PATH=/var/data/ritdorg/auth.db
